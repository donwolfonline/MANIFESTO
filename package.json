{
  "name": "manifesto",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0 --cache",
    "lint:fix": "eslint . --fix --cache",
    "fonts:sync": "node scripts/sync-fonts.mjs",
    "analyze": "ANALYZE=true npm run build",
    "budget": "node scripts/check-bundle-budget.mjs",
    "perf:measure": "npm run build && node scripts/measure-vitals.mjs",
    "perf:check": "node scripts/measure-vitals.mjs --assert",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:responsive": "npm run build && playwright test e2e/responsive.spec.ts",
    "test:e2e:snapshots": "npm run build && playwright test e2e/responsive.spec.ts --update-snapshots",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run budget && playwright test",
    "lhci": "npm run build && npx --yes @lhci/cli@0.15.x autorun --collect.startServerCommand=\"npm run preview -- --host 127.0.0.1 --port 4175 --strictPort\" --collect.startServerReadyPattern=4175 --collect.url=http://127.0.0.1:4175/ --collect.url=http://127.0.0.1:4175/wall --collect.url=http://127.0.0.1:4175/privacy",
    "new": "node scripts/new-content.mjs",
    "db:backup": "node scripts/backup-wall-db.mjs",
    "optimize-assets": "node scripts/optimize-assets.mjs",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "pwa:check": "node scripts/verify-pwa.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.4.7",
    "lenis": "^1.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.0.9",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "rollup-plugin-visualizer": "^7.1.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.2.0",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
