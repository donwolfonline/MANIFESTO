# Supabase project credentials (Server-side only — NEVER prefix with VITE_)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Password for the /admin moderation dashboard & one-click export (use a long random passphrase)
ADMIN_PASSWORD=change-me-to-a-long-random-passphrase

# Random secret salt for hashing visitor IPs during rate-limit checks (never stores raw IPs)
RATE_LIMIT_SALT=change-me-to-a-32-char-random-string

# Optional privacy-friendly error monitoring (GlitchTip — open-source, Sentry-compatible, cookie-free)
# Leave empty to use the built-in first-party /api/report-error serverless endpoint.
VITE_GLITCHTIP_DSN=

# Optional HTTPS webhook (Slack, Discord, or ntfy.sh) for server-side error & uptime alerts
ALERT_WEBHOOK_URL=
